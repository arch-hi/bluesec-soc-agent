# скопировать в .env и заполнить, сам .env не коммитить

# сервер соревнования, адрес и ключ из личного кабинета на bluesec.team
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# арена practice или graded, без неё берётся открытая сейчас
# SCENARIO_RUNTIME_ARENA=practice

GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=my-agent
AGENT_NAME=my-agent

# провайдер LLM с OpenAI-совместимым API
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=provider/model-name

LLM_TIMEOUT_SECONDS=300
LLM_MAX_COMPLETION_TOKENS=8192
LLM_MAX_STEP_RETRIES=5
LLM_SIMPLIFY_TOOL_SCHEMAS=true

# настройки, с которыми агент шёл в финал на DeepSeek V4.1 Flash
BLUESEC_AGENT_MAX_STEPS=30
BLUESEC_AGENT_MAX_TASKS=40
BLUESEC_AGENT_TOTAL_CAP=20
BLUESEC_AGENT_TYPE_BUDGETS=true
BLUESEC_AGENT_HARVEST_CALLS=6
BLUESEC_AGENT_COMPLETE_REPORT_SHARE=0.5
BLUESEC_AGENT_EMPTY_BENIGN_REVIEW=true
BLUESEC_AGENT_ARTIFACT_SWEEP=true
BLUESEC_AGENT_KEEP_GOING=true
